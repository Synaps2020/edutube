# Configuration locale. make config crée .env sans remplacer un fichier existant.
# Les variables du terminal et les options Make priment sur ce fichier.
HOST=127.0.0.1
PORT=3082
API_HOST=127.0.0.1
API_PORT=3083

# PostgreSQL local. Les commandes Make construisent DATABASE_URL depuis ces valeurs.
DB_PORT=5434
DB_PASSWORD=edutube-local
# Pour une base distante, définir explicitement DATABASE_URL.
# DATABASE_URL=postgresql://utilisateur:mot-de-passe@hote:5432/edutube
# L’origine est calculée depuis PORT ; la préciser pour un autre nom de domaine.
# WEB_ORIGIN=http://localhost:3082
STORAGE_DIR=data/resources

# Messagerie de test : http://localhost:8026
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=EduTube <bonjour@edutube.example.test>
SMTP_REQUIRE_TLS=false
SMTP_DOCKER_HOST=mailpit
SMTP_DOCKER_PORT=1025
# Pour un fournisseur SMTP, renseigner ses accès et activer TLS.
# SMTP_USER=
# SMTP_PASSWORD=

# Stockage vidéo privé. L’adresse locale est calculée depuis MINIO_PORT.
VIDEO_STORAGE=minio
MINIO_ACCESS_KEY=edutube-local
MINIO_SECRET_KEY=edutube-local-secret
MINIO_BUCKET=edutube-videos
MINIO_REGION=us-east-1
MINIO_PORT=9040
MINIO_CONSOLE_PORT=9041
# MINIO_ENDPOINT=http://127.0.0.1:9040

# Stockage WebDAV : créer d’abord un dossier privé et son compte de service.
# VIDEO_STORAGE=webdav
# WEBDAV_URL=https://cloud.example/remote.php/dav/files/compte/edutube-videos
# WEBDAV_USER=
# WEBDAV_PASSWORD=
# WEBDAV_TOKEN=

# Les exécutables fournis par npm sont utilisés en local par défaut.
# FFMPEG_PATH=chemin/vers/ffmpeg
# FFPROBE_PATH=chemin/vers/ffprobe

# Facultatif : vérification des comptes de démonstration déjà créés.
# TEST_PASSWORD=EduTube-Test2026!
# TEST_ORIGIN=http://localhost:3082
