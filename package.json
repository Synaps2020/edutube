{
  "name": "edutube",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:spec": "npm run openapi --workspace @edutube/contracts",
    "lint": "eslint apps/web apps/api packages/contracts scripts --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "test:integration": "npm run test:integration --workspace @edutube/api",
    "test:unit": "npm run test:unit --workspace @edutube/api && npm run test --workspace @edutube/web && npm run test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "light-my-request": "6.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
