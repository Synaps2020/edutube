{
  "title": "EduTube — Vue d'ensemble",
  "uid": "edutube-overview",
  "schemaVersion": 39,
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    { "type": "stat", "title": "Utilisateurs", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }, "targets": [{ "expr": "edu_users_total" }] },
    { "type": "stat", "title": "Contenus publiés", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }, "targets": [{ "expr": "edu_media_total{status=\"PUBLISHED\"}" }] },
    { "type": "stat", "title": "Vues 24 h", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 }, "targets": [{ "expr": "edu_views_24h" }] },
    { "type": "stat", "title": "Propositions en attente", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 }, "targets": [{ "expr": "edu_submissions_pending" }] },
    { "type": "timeseries", "title": "Jobs de traitement par statut", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }, "targets": [{ "expr": "edu_jobs_total", "legendFormat": "{{status}}" }] },
    { "type": "timeseries", "title": "Signalements ouverts", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }, "targets": [{ "expr": "edu_reports_open" }] },
    { "type": "timeseries", "title": "CPU hôte", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 }, "targets": [{ "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)" }] },
    { "type": "timeseries", "title": "Connexions PostgreSQL", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 }, "targets": [{ "expr": "pg_stat_database_numbackends" }] }
  ]
}
