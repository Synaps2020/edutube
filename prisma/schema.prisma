// Schéma de données — EduTube
// Ministère de l'Éducation nationale (MEN) — République du Sénégal
//
// Choix notables :
//  - Les identifiants sont des cuid (opaques, non séquentiels) pour éviter l'énumération.
//  - Un média (vidéo/audio) porte toutes ses métadonnées pédagogiques obligatoires.
//  - Les propositions (Submission) des enseignants/élèves sont un objet distinct : elles ne
//    deviennent un Media qu'après validation par un administrateur (seul habilité à publier).
//  - La file de transcodage (Job) est stockée en base : le worker la consomme via
//    SELECT ... FOR UPDATE SKIP LOCKED, ce qui évite d'opérer Redis dans la version initiale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum MediaType {
  VIDEO
  AUDIO
}

enum MediaStatus {
  DRAFT       // créé par un admin, fichier pas encore finalisé ou publication différée
  PENDING     // en attente de validation (issu d'une proposition)
  PROCESSING  // transcodage en cours
  PUBLISHED   // visible par tous
  REJECTED    // refusé avec motif
  ARCHIVED    // retiré de la diffusion, conservé
  FAILED      // échec de transcodage
}

enum Difficulty {
  DECOUVERTE
  INTERMEDIAIRE
  APPROFONDISSEMENT
}

enum Language {
  FR
  WO
  AR
  EN
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  PENDING
}

enum ReportTarget {
  MEDIA
  COMMENT
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum JobType {
  TRANSCODE_VIDEO
  PROCESS_AUDIO
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum NotificationType {
  SUBMISSION_RECEIVED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  RECOMMENDATION
  COMMENT_REPLY
  REPORT_RECEIVED
  MEDIA_PUBLISHED
  SYSTEM
}

enum ModerationTarget {
  MEDIA
  SUBMISSION
  COMMENT
  REPORT
  USER
}

// ---------------------------------------------------------------------------
// Utilisateurs & référentiels
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role       @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  locale        String     @default("fr")
  // Rattachement au système éducatif
  classLevelId  String?
  classLevel    ClassLevel? @relation(fields: [classLevelId], references: [id])
  establishment String?    // ex. Lycée Blaise Diagne, École élémentaire Ndiarème
  region        String?    // ex. Dakar, Thiès, Ziguinchor
  ief           String?    // Inspection de l'Éducation et de la Formation
  ia            String?    // Inspection d'Académie
  bio           String?
  avatarPath    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  channels        Channel[]
  subscriptions   Subscription[]
  uploadedMedia   Media[]          @relation("MediaUploader")
  contributedMedia Media[]         @relation("MediaContributor")
  submissions     Submission[]     @relation("SubmissionAuthor")
  reviewedSubmissions Submission[] @relation("SubmissionReviewer")
  comments        Comment[]
  likes           Like[]
  favorites       Favorite[]
  playlists       Playlist[]
  watchHistory    WatchHistory[]
  viewEvents      ViewEvent[]
  sentRecommendations     Recommendation[] @relation("RecoSender")
  receivedRecommendations Recommendation[] @relation("RecoRecipient")
  notifications   Notification[]
  reports         Report[]         @relation("Reporter")
  resolvedReports Report[]         @relation("ReportResolver")
  moderationDecisions ModerationDecision[]
  auditLogs       AuditLog[]

  @@index([role])
  @@index([classLevelId])
}

model Cycle {
  id       String  @id @default(cuid())
  code     String  @unique // PRIMAIRE, MOYEN, SECONDAIRE
  name     String
  order    Int
  classes  ClassLevel[]
  media    Media[]
  submissions Submission[]
}

model ClassLevel {
  id       String  @id @default(cuid())
  code     String  @unique // CI, CP, CE1, CE2, CM1, CM2, 6E, 5E, 4E, 3E, 2NDE, 1ERE, TLE
  name     String
  order    Int
  cycleId  String
  cycle    Cycle   @relation(fields: [cycleId], references: [id])
  users    User[]
  media    Media[]
  submissions Submission[]
  recommendations Recommendation[]
}

model Discipline {
  id    String  @id @default(cuid())
  code  String  @unique
  name  String
  color String  @default("#00853F")
  media Media[]
  submissions Submission[]
}

model Theme {
  id    String  @id @default(cuid())
  code  String  @unique
  name  String
  description String?
  media Media[]
  submissions Submission[]
}

// ---------------------------------------------------------------------------
// Chaînes & abonnements
// ---------------------------------------------------------------------------

model Channel {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isOfficial  Boolean  @default(false)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  avatarPath  String?
  createdAt   DateTime @default(now())
  media       Media[]
  subscribers Subscription[]
}

model Subscription {
  userId    String
  channelId String
  createdAt DateTime @default(now())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

// ---------------------------------------------------------------------------
// Médias
// ---------------------------------------------------------------------------

model Media {
  id            String      @id @default(cuid())
  slug          String      @unique
  shortCode     String      @unique // partage par code court : /v/XXXXXX
  type          MediaType
  status        MediaStatus @default(DRAFT)
  title         String
  description   String
  // Métadonnées pédagogiques obligatoires
  cycleId       String
  cycle         Cycle       @relation(fields: [cycleId], references: [id])
  classLevelId  String
  classLevel    ClassLevel  @relation(fields: [classLevelId], references: [id])
  disciplineId  String
  discipline    Discipline  @relation(fields: [disciplineId], references: [id])
  themeId       String
  theme         Theme       @relation(fields: [themeId], references: [id])
  chapter       String
  keywords      String[]
  language      Language    @default(FR)
  license       String      @default("CC BY-NC-SA 4.0")
  pedagogicalAuthor String  // auteur pédagogique (enseignant, inspecteur, cellule…)
  difficulty    Difficulty  @default(INTERMEDIAIRE)
  // Acteurs
  uploaderId    String
  uploader      User        @relation("MediaUploader", fields: [uploaderId], references: [id])
  contributorId String?     // enseignant/élève à l'origine de la proposition
  contributor   User?       @relation("MediaContributor", fields: [contributorId], references: [id])
  channelId     String
  channel       Channel     @relation(fields: [channelId], references: [id])
  // Fichiers (chemins relatifs à MEDIA_ROOT)
  originalPath  String?
  originalName  String?
  originalSize  BigInt?
  hlsMasterPath String?     // vidéo : master.m3u8
  audioPath     String?     // audio : fichier normalisé (m4a)
  waveformPath  String?     // audio : pics JSON pour l'affichage
  thumbnailPath String?
  subtitlesPath String?     // WebVTT
  transcript    String?     // texte intégral (recherche plein texte + accessibilité)
  youtubeVideoId String?    @unique // lecture via YouTube (chaîne officielle SIMEN / MEN)
  renditions    Json?       // [{height, bandwidth, path}]
  durationSec   Int?
  width         Int?
  height        Int?
  downloadable  Boolean     @default(false)
  // Compteurs dénormalisés (mis à jour de façon atomique)
  viewCount     Int         @default(0)
  likeCount     Int         @default(0)
  commentCount  Int         @default(0)
  // Cycle de vie
  rejectionReason String?
  processingError String?
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  jobs          Job[]
  comments      Comment[]
  likes         Like[]
  favorites     Favorite[]
  playlistItems PlaylistItem[]
  watchHistory  WatchHistory[]
  viewEvents    ViewEvent[]
  recommendations Recommendation[]
  submission    Submission?

  @@index([status, publishedAt])
  @@index([type])
  @@index([cycleId, classLevelId])
  @@index([disciplineId])
  @@index([themeId])
  @@index([channelId])
  @@index([language])
}

// Propositions d'enseignants / d'élèves : file d'attente avant toute publication.
model Submission {
  id            String           @id @default(cuid())
  type          MediaType
  title         String
  description   String
  cycleId       String
  cycle         Cycle            @relation(fields: [cycleId], references: [id])
  classLevelId  String
  classLevel    ClassLevel       @relation(fields: [classLevelId], references: [id])
  disciplineId  String
  discipline    Discipline       @relation(fields: [disciplineId], references: [id])
  themeId       String
  theme         Theme            @relation(fields: [themeId], references: [id])
  chapter       String?
  keywords      String[]
  language      Language         @default(FR)
  sourceUrl     String?          // lien externe éventuel (ex. fichier partagé)
  attachmentPath String?         // fichier déposé (non publié tant que non validé)
  attachmentName String?
  attachmentSize BigInt?
  status        SubmissionStatus @default(PENDING)
  authorId      String
  author        User             @relation("SubmissionAuthor", fields: [authorId], references: [id])
  reviewerId    String?
  reviewer      User?            @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  reviewNote    String?          // retour motivé
  reviewedAt    DateTime?
  mediaId       String?          @unique
  media         Media?           @relation(fields: [mediaId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([authorId])
}

// File de traitement (transcodage / normalisation)
model Job {
  id        String    @id @default(cuid())
  type      JobType
  status    JobStatus @default(QUEUED)
  mediaId   String
  media     Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  payload   Json?
  attempts  Int       @default(0)
  maxAttempts Int     @default(3)
  error     String?
  progress  Int       @default(0)
  lockedBy  String?
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  startedAt DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Engagement communautaire
// ---------------------------------------------------------------------------

model Comment {
  id        String        @id @default(cuid())
  mediaId   String
  media     Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    Comment?      @relation("Replies", fields: [parentId], references: [id])
  replies   Comment[]     @relation("Replies")
  content   String
  status    CommentStatus @default(VISIBLE)
  hiddenReason String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([mediaId, status, createdAt])
}

model Like {
  userId    String
  mediaId   String
  createdAt DateTime @default(now())
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
}

model Favorite {
  userId    String
  mediaId   String
  createdAt DateTime @default(now())
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
}

model Playlist {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       PlaylistItem[]

  @@index([ownerId])
}

model PlaylistItem {
  playlistId String
  mediaId    String
  position   Int
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([playlistId, mediaId])
}

// Reprise de lecture + progression individuelle
model WatchHistory {
  userId        String
  mediaId       String
  positionSec   Int      @default(0)
  maxPositionSec Int     @default(0)
  completed     Boolean  @default(false)
  lastWatchedAt DateTime @default(now())
  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media         Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@index([userId, lastWatchedAt])
}

// Événements de vue (pour les statistiques d'audience)
model ViewEvent {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  createdAt DateTime @default(now())

  @@index([mediaId, createdAt])
  @@index([createdAt])
}

// Recommandation privée à un utilisateur OU diffusion à une classe
model Recommendation {
  id           String   @id @default(cuid())
  senderId     String
  sender       User     @relation("RecoSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId  String?
  recipient    User?    @relation("RecoRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  classLevelId String?
  classLevel   ClassLevel? @relation(fields: [classLevelId], references: [id])
  mediaId      String
  media        Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  message      String?
  createdAt    DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([classLevelId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// ---------------------------------------------------------------------------
// Modération, signalements, audit
// ---------------------------------------------------------------------------

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id])
  targetType  ReportTarget
  targetId    String
  reason      String
  details     String?
  status      ReportStatus @default(OPEN)
  resolvedById String?
  resolvedBy  User?        @relation("ReportResolver", fields: [resolvedById], references: [id])
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationDecision {
  id          String           @id @default(cuid())
  moderatorId String
  moderator   User             @relation(fields: [moderatorId], references: [id])
  targetType  ModerationTarget
  targetId    String
  action      String           // APPROVE, REJECT, ARCHIVE, HIDE, RESTORE, SUSPEND…
  reason      String?
  createdAt   DateTime         @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // ex. USER_LOGIN, MEDIA_CREATE, MEDIA_PUBLISH, USER_ROLE_CHANGE
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entity, entityId])
}

// Paramètres modifiables à chaud (quotas, limites…)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
