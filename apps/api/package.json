{
  "name": "@edutube/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/project.mjs run node --import tsx --watch apps/api/src/main.ts",
    "start": "node ../../scripts/project.mjs run node --import tsx apps/api/src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/postgres.integration.test.ts test/learning.integration.test.ts test/teaching.integration.test.ts test/resources.integration.test.ts test/identity.integration.test.ts test/videos.integration.test.ts test/administration.integration.test.ts",
    "course:owner": "tsx scripts/course-owner.ts",
    "account:role": "tsx scripts/account-role.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:videos": "tsx scripts/seed-videos.ts",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@edutube/contracts": "0.1.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.0.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "fastify": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.0.0",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.0.0",
    "typescript": "~5.7.3",
    "vitest": "^4.1.11"
  }
}
